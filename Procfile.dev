backend: eval "$(rbenv init -)" && bin/rails s -p 3000
# https://github.com/mperham/sidekiq/issues/3090#issuecomment-389748695
worker: eval "$(rbenv init -)" && dotenv bundle exec sidekiq -C config/sidekiq.yml
vite: eval "$(rbenv init -)" && bin/vite dev
uazapi_sse: eval "$(rbenv init -)" && dotenv bundle exec rake uazapi:sse_daemon
