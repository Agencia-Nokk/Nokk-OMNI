<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
  <!-- Breadcrumb -->
  <nav class="mb-6">
    <ol class="flex items-center gap-2 text-sm text-slate-500">
      <li>
        <a href="<%= public_shop_path(account_slug: account_slug_param) %>" class="hover:text-woot-500 transition-colors">
          Início
        </a>
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <% if @product.category %>
        <li>
          <a href="<%= public_shop_category_path(account_slug: account_slug_param, category_slug: @product.category.slug) %>" class="hover:text-woot-500 transition-colors">
            <%= @product.category.name %>
          </a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </li>
      <% end %>
      <li class="text-slate-900 font-medium truncate max-w-[200px]">
        <%= @product.name %>
      </li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
    <!-- Galeria de Imagens -->
    <div class="space-y-4">
      <!-- Imagem Principal -->
      <div class="aspect-square bg-slate-100 rounded-2xl overflow-hidden" id="main-image-container">
        <% if @product.images.attached? && @product.images.first.present? %>
          <%= image_tag url_for(@product.images.first),
              alt: @product.name,
              id: "main-image",
              class: "w-full h-full object-contain" %>
        <% else %>
          <div class="flex items-center justify-center h-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        <% end %>
      </div>

      <!-- Thumbnails -->
      <% if @product.images.attached? && @product.images.count > 1 %>
        <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
          <% @product.images.each_with_index do |image, index| %>
            <button
              type="button"
              class="flex-shrink-0 w-20 h-20 bg-slate-100 rounded-xl overflow-hidden border-2 transition-all thumbnail-btn <%= index == 0 ? 'border-woot-500' : 'border-transparent hover:border-slate-300' %>"
              data-image-url="<%= url_for(image) %>"
              onclick="changeMainImage(this)"
            >
              <%= image_tag url_for(image.variant(resize_to_limit: [100, 100])),
                  alt: "#{@product.name} - Imagem #{index + 1}",
                  class: "w-full h-full object-cover" %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Informações do Produto -->
    <div class="space-y-6">
      <!-- Categoria -->
      <% if @product.category %>
        <a href="<%= public_shop_category_path(account_slug: account_slug_param, category_slug: @product.category.slug) %>" class="inline-block px-3 py-1 bg-slate-100 text-slate-600 text-sm font-medium rounded-full hover:bg-slate-200 transition-colors">
          <%= @product.category.name %>
        </a>
      <% end %>

      <!-- Nome do Produto -->
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">
        <%= @product.name %>
      </h1>

      <!-- Preço -->
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-3xl font-bold text-slate-900" data-product-price style="<%= @settings.show_prices? ? '' : 'display:none' %>">
          <%= number_to_currency(@product.price, unit: "R$ ", separator: ",", delimiter: ".") %>
        </span>
        <% if @product.on_sale? && @product.compare_at_price.present? %>
          <span class="text-lg text-slate-400 line-through" data-product-price style="<%= @settings.show_prices? ? '' : 'display:none' %>">
            <%= number_to_currency(@product.compare_at_price, unit: "R$ ", separator: ",", delimiter: ".") %>
          </span>
          <span class="px-2 py-1 bg-red-500 text-white text-sm font-bold rounded-lg" data-product-price style="<%= @settings.show_prices? ? '' : 'display:none' %>">
            -<%= @product.discount_percentage %>%
          </span>
        <% end %>
        <span class="text-2xl font-semibold text-woot-600" data-contact-price style="<%= @settings.show_prices? ? 'display:none' : '' %>">Consulte o preço</span>
      </div>

      <!-- Descrição -->
      <% if @product.description.present? %>
        <div class="prose prose-slate max-w-none">
          <p class="text-slate-600 whitespace-pre-line leading-relaxed">
            <%= @product.description %>
          </p>
        </div>
      <% end %>

      <hr class="border-slate-200">

      <!-- Variantes -->
      <% if @product.variants.active.any? %>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-3">Selecione uma opção</label>
          <div class="flex flex-wrap gap-2" id="variants-container">
            <% @product.variants.active.each do |variant| %>
              <button
                type="button"
                class="variant-btn px-4 py-2.5 border-2 border-slate-200 rounded-xl text-sm font-medium text-slate-700 hover:border-woot-500 hover:text-woot-600 transition-all"
                data-variant-id="<%= variant.id %>"
                data-variant-name="<%= variant.name %>"
                data-variant-price="<%= variant.price || @product.price %>"
                data-variant-stock="<%= variant.stock_quantity %>"
                onclick="selectVariant(this)"
              >
                <%= variant.name %>
                <% if variant.price && variant.price != @product.price %>
                  <span class="text-woot-500 ml-1">
                    +<%= number_to_currency(variant.price - @product.price, unit: "R$ ", separator: ",", delimiter: ".") %>
                  </span>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Quantidade -->
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-3">Quantidade</label>
        <div class="flex items-center gap-1 bg-slate-100 rounded-xl p-1 w-fit">
          <button
            type="button"
            class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-white hover:shadow-sm transition-all text-slate-600"
            onclick="changeQuantity(-1)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
            </svg>
          </button>
          <input
            type="number"
            id="quantity-input"
            value="1"
            min="1"
            class="w-14 h-10 text-center bg-transparent text-slate-900 font-medium text-lg border-0 focus:ring-0"
            readonly
          />
          <button
            type="button"
            class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-white hover:shadow-sm transition-all text-slate-600"
            onclick="changeQuantity(1)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Estoque -->
      <% if @product.track_inventory %>
        <div>
          <% if @product.in_stock? %>
            <div class="flex items-center gap-2 text-green-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-sm font-medium">Em estoque (<%= @product.stock_quantity %> disponíveis)</span>
            </div>
          <% else %>
            <div class="flex items-center gap-2 text-red-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-sm font-medium">Produto indisponível</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Botão Adicionar ao Carrinho -->
      <button
        type="button"
        id="add-to-cart-btn"
        class="w-full py-4 px-6 bg-woot-500 hover:bg-woot-600 text-white font-semibold rounded-xl transition-all shadow-lg shadow-woot-500/25 hover:shadow-xl hover:shadow-woot-500/30 disabled:opacity-50 disabled:cursor-not-allowed disabled:shadow-none flex items-center justify-center gap-2"
        onclick="addProductToCart()"
        <%= 'disabled' unless @product.in_stock? %>
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        Adicionar ao Carrinho
      </button>

      <!-- Link para ver carrinho -->
      <a
        href="<%= public_shop_cart_path(account_slug: account_slug_param) %>"
        class="block text-center text-sm text-slate-500 hover:text-woot-500 transition-colors"
      >
        Ver carrinho
      </a>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  // Product data
  const productData = {
    id: <%= @product.id %>,
    name: "<%= j @product.name %>",
    price: <%= @product.price %>,
    image: "<%= @product.images.attached? ? url_for(@product.images.first.variant(resize_to_limit: [100, 100])) : '' %>"
  };

  let selectedVariant = null;
  let quantity = 1;

  // Change main image
  function changeMainImage(button) {
    const mainImage = document.getElementById('main-image');
    if (mainImage) {
      mainImage.src = button.dataset.imageUrl;
    }

    // Update active state
    document.querySelectorAll('.thumbnail-btn').forEach(btn => {
      btn.classList.remove('border-woot-500');
      btn.classList.add('border-transparent');
    });
    button.classList.remove('border-transparent');
    button.classList.add('border-woot-500');
  }

  // Select variant
  function selectVariant(button) {
    // Remove selection from all
    document.querySelectorAll('.variant-btn').forEach(btn => {
      btn.classList.remove('border-woot-500', 'bg-woot-50', 'text-woot-600');
      btn.classList.add('border-slate-200', 'text-slate-700');
    });

    // Add selection to clicked
    button.classList.remove('border-slate-200', 'text-slate-700');
    button.classList.add('border-woot-500', 'bg-woot-50', 'text-woot-600');

    selectedVariant = {
      id: button.dataset.variantId,
      name: button.dataset.variantName,
      price: parseFloat(button.dataset.variantPrice)
    };
  }

  // Change quantity
  function changeQuantity(delta) {
    const input = document.getElementById('quantity-input');
    const newValue = Math.max(1, parseInt(input.value) + delta);
    input.value = newValue;
    quantity = newValue;
  }

  // Add to cart
  function addProductToCart() {
    const hasVariants = document.querySelectorAll('.variant-btn').length > 0;

    if (hasVariants && !selectedVariant) {
      window.Shop.showToast('Selecione uma opção', 'error');
      return;
    }

    window.Shop.addToCart({
      id: productData.id,
      name: productData.name,
      price: selectedVariant ? selectedVariant.price : productData.price,
      image: productData.image,
      variantId: selectedVariant ? selectedVariant.id : null,
      variantName: selectedVariant ? selectedVariant.name : null,
      quantity: quantity
    });
  }
</script>
