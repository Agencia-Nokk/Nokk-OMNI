<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
  <!-- Categorias -->
  <% if @categories.any? %>
    <div class="mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-hide">
        <a
          href="<%= public_shop_path(account_slug: account_slug_param) %>"
          class="flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all
            <%= @category.nil? ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>"
        >
          Todos os produtos
        </a>
        <% @categories.each do |category| %>
          <a
            href="<%= public_shop_category_path(account_slug: account_slug_param, category_slug: category.slug) %>"
            class="flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all
              <%= @category&.id == category.id ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>"
          >
            <%= category.name %>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Título da Categoria -->
  <% if @category %>
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900"><%= @category.name %></h1>
      <% if @category.description.present? %>
        <p class="text-slate-600 mt-2"><%= @category.description %></p>
      <% end %>
    </div>
  <% else %>
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Nossos Produtos</h1>
      <p class="text-slate-600 mt-2">Confira nosso catálogo completo</p>
    </div>
  <% end %>

  <!-- Grid de Produtos -->
  <% if @products.any? %>
    <%
      # Define grid columns based on products_per_row setting
      grid_cols = case @settings.products_per_row
                  when 2 then 'grid-cols-1 sm:grid-cols-2'
                  when 4 then 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4'
                  else 'grid-cols-2 sm:grid-cols-3' # default: 3
                  end

      # Define card style classes
      card_class = case @settings.card_style
                   when 'border' then 'border-2 border-slate-200 hover:border-slate-400'
                   when 'minimal' then ''
                   else 'shadow-sm hover:shadow-lg' # default: shadow
                   end
    %>
    <div class="grid <%= grid_cols %> gap-4 sm:gap-6" data-products-grid>
      <% @products.each do |product| %>
        <a
          href="<%= public_shop_product_path(account_slug: account_slug_param, product_slug: product.slug) %>"
          class="group bg-white rounded-2xl overflow-hidden transition-all duration-300 <%= card_class %>"
          data-product-card
        >
          <!-- Imagem -->
          <div class="aspect-square bg-slate-100 relative overflow-hidden">
            <% if product.images.attached? && product.images.first.present? %>
              <%= image_tag url_for(product.images.first.variant(resize_to_limit: [400, 400])),
                  alt: product.name,
                  class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500",
                  loading: "lazy" %>
            <% else %>
              <div class="flex items-center justify-center h-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            <% end %>

            <!-- Badge de Destaque -->
            <% if product.featured? %>
              <div class="absolute top-3 left-3 px-2 py-1 text-white text-xs font-bold rounded-lg bg-shop-primary" data-featured-badge style="<%= @settings.show_featured_badge? ? '' : 'display:none' %>">
                <span data-featured-badge-text><%= @settings.featured_badge_text.presence || 'Destaque' %></span>
              </div>
            <% end %>

            <!-- Badge de Promoção -->
            <% if product.on_sale? && product.discount_percentage.present? %>
              <div class="absolute top-3 <%= product.featured? && @settings.show_featured_badge? ? 'right-3' : 'left-3' %> px-2 py-1 bg-red-500 text-white text-xs font-bold rounded-lg">
                -<%= product.discount_percentage %>%
              </div>
            <% end %>
          </div>

          <!-- Info -->
          <div class="p-4">
            <h3 class="font-medium text-slate-900 text-sm sm:text-base line-clamp-2 mb-2 group-hover:text-shop-primary transition-colors">
              <%= product.name %>
            </h3>

            <div class="flex items-baseline gap-2 flex-wrap">
              <span class="text-lg font-bold text-slate-900" data-product-price style="<%= @settings.show_prices? ? '' : 'display:none' %>">
                <%= number_to_currency(product.price, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
              <% if product.compare_at_price.present? && product.compare_at_price > product.price %>
                <span class="text-sm text-slate-400 line-through" data-product-price style="<%= @settings.show_prices? ? '' : 'display:none' %>">
                  <%= number_to_currency(product.compare_at_price, unit: "R$ ", separator: ",", delimiter: ".") %>
                </span>
              <% end %>
              <span class="text-lg font-medium text-shop-primary" data-contact-price style="<%= @settings.show_prices? ? 'display:none' : '' %>">Consulte</span>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="text-center py-16">
      <div class="w-20 h-20 mx-auto mb-6 bg-slate-100 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-slate-900 mb-2">Nenhum produto encontrado</h3>
      <p class="text-slate-500 max-w-md mx-auto">
        <% if @category %>
          Esta categoria ainda não possui produtos disponíveis.
        <% else %>
          Esta loja ainda não possui produtos cadastrados.
        <% end %>
      </p>
    </div>
  <% end %>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
