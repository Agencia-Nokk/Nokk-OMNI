<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Meu Carrinho</h1>
    <p class="text-slate-500 mt-1">Revise seus itens antes de finalizar</p>
  </div>

  <div id="cart-content">
    <!-- Será preenchido via JavaScript -->
  </div>
</div>

<script>
  const shopPath = '<%= public_shop_path(account_slug: account_slug_param) %>';

  function renderCart() {
    const container = document.getElementById('cart-content');
    const cart = window.Shop.getCart();

    if (cart.items.length === 0) {
      container.innerHTML = `
        <div class="text-center py-16">
          <div class="w-24 h-24 mx-auto mb-6 bg-slate-100 rounded-full flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">Seu carrinho está vazio</h3>
          <p class="text-slate-500 mb-8 max-w-md mx-auto">Explore nossos produtos e adicione itens ao seu carrinho para começar.</p>
          <a
            href="${shopPath}"
            class="inline-flex items-center gap-2 px-6 py-3 bg-woot-500 hover:bg-woot-600 text-white font-medium rounded-xl transition-all shadow-lg shadow-woot-500/25"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Ver Produtos
          </a>
        </div>
      `;
      return;
    }

    let itemsHtml = '';
    cart.items.forEach((item, index) => {
      itemsHtml += `
        <div class="flex gap-4 p-4 bg-white rounded-2xl border border-slate-200 hover:border-slate-300 transition-colors">
          <!-- Imagem -->
          <div class="w-24 h-24 sm:w-28 sm:h-28 bg-slate-100 rounded-xl overflow-hidden flex-shrink-0">
            ${item.image
              ? `<img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" />`
              : `<div class="flex items-center justify-center h-full">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>`
            }
          </div>

          <!-- Info -->
          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-start gap-2">
              <div class="min-w-0">
                <h3 class="font-semibold text-slate-900 truncate">${item.name}</h3>
                ${item.variantName ? `<p class="text-sm text-slate-500 mt-0.5">${item.variantName}</p>` : ''}
              </div>
              <button
                type="button"
                class="flex-shrink-0 p-2 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all"
                onclick="removeItem(${index})"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>

            <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
              <!-- Controle de Quantidade -->
              <div class="flex items-center gap-1 bg-slate-100 rounded-lg p-1">
                <button
                  type="button"
                  class="w-8 h-8 flex items-center justify-center rounded-md hover:bg-white hover:shadow-sm transition-all text-slate-600"
                  onclick="updateItemQuantity(${index}, ${item.quantity - 1})"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                  </svg>
                </button>
                <span class="w-8 text-center text-slate-900 font-medium">${item.quantity}</span>
                <button
                  type="button"
                  class="w-8 h-8 flex items-center justify-center rounded-md hover:bg-white hover:shadow-sm transition-all text-slate-600"
                  onclick="updateItemQuantity(${index}, ${item.quantity + 1})"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>

              <!-- Preço -->
              <div class="text-right">
                <p class="text-sm text-slate-500">${window.Shop.formatCurrency(item.price)} cada</p>
                <p class="text-lg font-bold text-slate-900">${window.Shop.formatCurrency(item.price * item.quantity)}</p>
              </div>
            </div>
          </div>
        </div>
      `;
    });

    const total = window.Shop.getTotal();
    const itemCount = window.Shop.getItemCount();

    container.innerHTML = `
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Lista de Itens -->
        <div class="lg:col-span-2 space-y-4">
          ${itemsHtml}

          <div class="flex justify-between items-center pt-4">
            <button
              type="button"
              class="flex items-center gap-2 text-sm text-slate-500 hover:text-red-500 transition-colors"
              onclick="clearCart()"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              Limpar carrinho
            </button>
            <a
              href="${shopPath}"
              class="flex items-center gap-2 text-sm text-woot-500 hover:text-woot-600 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
              </svg>
              Continuar comprando
            </a>
          </div>
        </div>

        <!-- Resumo -->
        <div class="lg:col-span-1">
          <div class="bg-slate-50 rounded-2xl p-6 sticky top-24">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">Resumo do Pedido</h3>

            <div class="space-y-3 mb-4">
              <div class="flex justify-between text-slate-600">
                <span>Subtotal (${itemCount} ${itemCount === 1 ? 'item' : 'itens'})</span>
                <span class="font-medium">${window.Shop.formatCurrency(total)}</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>Frete</span>
                <span class="text-sm text-slate-400">A calcular</span>
              </div>
            </div>

            <div class="border-t border-slate-200 pt-4 mb-6">
              <div class="flex justify-between items-center">
                <span class="text-lg font-semibold text-slate-900">Total</span>
                <span class="text-2xl font-bold text-woot-500">${window.Shop.formatCurrency(total)}</span>
              </div>
            </div>

            ${window.Shop.minimumOrderValue > 0 && !window.Shop.checkMinimumOrder() ? `
              <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-xl">
                <p class="text-sm text-amber-700 flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  ${window.Shop.minimumOrderMessage}
                </p>
              </div>
            ` : ''}

            <button
              type="button"
              class="w-full py-4 px-6 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-xl transition-all shadow-lg shadow-green-500/25 hover:shadow-xl flex items-center justify-center gap-3"
              onclick="finishViaWhatsApp()"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Finalizar pelo WhatsApp
            </button>

            <p class="text-xs text-slate-500 text-center mt-4">
              Você será redirecionado para o WhatsApp para concluir seu pedido com o vendedor
            </p>
          </div>
        </div>
      </div>
    `;
  }

  function removeItem(index) {
    window.Shop.removeFromCart(index);
    renderCart();
    window.Shop.showToast('Item removido do carrinho', 'info');
  }

  function updateItemQuantity(index, quantity) {
    window.Shop.updateQuantity(index, quantity);
    renderCart();
  }

  function clearCart() {
    if (confirm('Tem certeza que deseja limpar o carrinho?')) {
      window.Shop.clearCart();
      renderCart();
      window.Shop.showToast('Carrinho limpo', 'info');
    }
  }

  function finishViaWhatsApp() {
    // Verifica se o carrinho está vazio
    if (window.Shop.getItemCount() === 0) {
      window.Shop.showToast('Seu carrinho está vazio', 'error');
      return;
    }

    // Verifica pedido mínimo
    if (!window.Shop.checkMinimumOrder()) {
      window.Shop.showToast(window.Shop.minimumOrderMessage, 'error');
      return;
    }

    const whatsappUrl = window.Shop.getWhatsAppUrl();
    if (whatsappUrl) {
      window.open(whatsappUrl, '_blank');
    }
  }

  // Render cart on page load
  document.addEventListener('DOMContentLoaded', renderCart);
  document.addEventListener('turbolinks:load', renderCart);
</script>
